# Copy this to .env on the server and fill it in. Never commit or share .env.

# Your free DuckDNS address (no https://)
DOMAIN=chibidink.duckdns.org

# Site address used in password reset emails
App__PublicUrl=https://chibidink.duckdns.org

# Password reset emails (Brevo, free): an API key and a sender email verified in Brevo
Email__BrevoApiKey=
Email__FromAddress=

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (.NET format).
# Add ";SSL Mode=Require;Trust Server Certificate=true" at the end if it isn't there.
ConnectionStrings__DefaultConnection=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOURPROJECT;Password=YOURPASSWORD;SSL Mode=Require;Trust Server Certificate=true
